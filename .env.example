# PostgreSQL connection (EU-hosted in production)
DATABASE_URL=postgres://postgres@localhost:5432/itckar_dev
# Used only by integration tests
DATABASE_URL_TEST=postgres://postgres@localhost:5432/itckar_test
# 32+ random bytes, base64 - signs session cookies
SESSION_SECRET=change-me-in-production-please-use-32-bytes
# Public base URL of the web app (used in e-mails/SMS links)
APP_URL=http://localhost:3000
# Notification providers: "console" logs messages, "smtp"/"bulkgate" real providers
EMAIL_PROVIDER=console
SMS_PROVIDER=console
