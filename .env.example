# PostgreSQL connection (EU-hosted in production)
DATABASE_URL=postgres://postgres@localhost:5432/itckar_dev
# Used only by integration tests
DATABASE_URL_TEST=postgres://postgres@localhost:5432/itckar_test
# 32+ random bytes, base64 - signs session cookies
SESSION_SECRET=change-me-in-production-please-use-32-bytes
# Public base URL of the web app (used in e-mails/SMS links)
APP_URL=http://localhost:3000
# Notification providers: "console" logs messages, "smtp"/"bulkgate" real providers
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# --- Notification providers (worker) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=rezervacie@vasa-domena.sk
# SMS_PROVIDER=bulkgate            # or twilio
# BULKGATE_APP_ID=
# BULKGATE_APP_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMS_SENDER_ID=Salon              # alphanumeric sender (where the operator allows it)
# WORKER_POLL_MS=5000

# Optional: single-IP header OVERWRITTEN by your trusted reverse proxy.
# Leave empty until the proxy strips caller-provided values and blocks direct origin access.
# Without this setting (or for an absent/invalid header), tenant-wide limits still apply.
RATE_LIMIT_IP_HEADER=

# Phone verification is required for public booking. Configure a real SMS_PROVIDER above.
# Local preview only: set demo explicitly AND use a loopback APP_URL to show simulated codes.
PHONE_VERIFICATION_MODE=required
