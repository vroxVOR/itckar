{
  "name": "itckar",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-vertical appointment booking SaaS for small service businesses (salons, barbers, beauty, massage, wellness).",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @itckar/web build",
    "dev": "pnpm --filter @itckar/web dev",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @itckar/scheduling --filter @itckar/shared test",
    "test:db": "pnpm --filter @itckar/db test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @itckar/db migrate",
    "db:seed": "pnpm --filter @itckar/db seed",
    "db:reset": "pnpm --filter @itckar/db reset",
    "worker": "pnpm --filter @itckar/web worker"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
